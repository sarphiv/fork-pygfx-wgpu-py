FROM mcr.microsoft.com/devcontainers/python:1-3.10-bookworm

ARG USERNAME=non-root
ARG USER_UID=1000
ARG USER_GID=${USER_UID}
ARG RUST_VERSION=1.87.0

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/non-root \
    SHELL=/usr/bin/zsh \
    UV_PROJECT_ENVIRONMENT=/workspace/.venv \
    UV_CACHE_DIR=/home/non-root/.cache/uv \
    VIRTUAL_ENV=/workspace/.venv \
    XDG_CACHE_HOME=/home/non-root/.cache \
    MESA_SHADER_CACHE_DIR=/home/non-root/.cache/mesa_shader_cache \
    CARGO_HOME=/home/non-root/.cargo \
    RUSTUP_HOME=/home/non-root/.rustup \
    CARGO_TARGET_DIR=/home/non-root/.cache/cargo-target \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=all \
    VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.x86_64.json \
    XDG_RUNTIME_DIR=/tmp/wayland \
    XDG_SESSION_TYPE=wayland \
    DISPLAY= \
    PATH=/workspace/.venv/bin:/home/non-root/.cargo/bin:/home/non-root/.local/bin:${PATH}

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

USER root

RUN find /etc/apt/sources.list.d -type f -name '*yarn*' -delete \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        clang \
        cmake \
        curl \
        file \
        git \
        gnupg \
        jq \
        lld \
        libegl1 \
        libffi-dev \
        libgl1 \
        libglfw3 \
        libvulkan-dev \
        libvulkan1 \
        libwayland-client0 \
        libwayland-cursor0 \
        libwayland-egl1 \
        libx11-6 \
        libxcursor1 \
        libxi6 \
        libxinerama1 \
        libxkbcommon0 \
        libxrandr2 \
        mesa-utils \
        ninja-build \
        patchelf \
        pkg-config \
        python3-dev \
        sudo \
        unzip \
        vulkan-tools \
        zip \
        zsh \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /usr/share/vulkan/icd.d \
    && printf '%s\n' \
        '{' \
        '  "file_format_version": "1.0.0",' \
        '  "ICD": {' \
        '    "library_path": "libGLX_nvidia.so.0",' \
        '    "api_version": "1.3.0"' \
        '  }' \
        '}' \
        > /usr/share/vulkan/icd.d/nvidia_icd.x86_64.json

RUN if id -u "${USERNAME}" >/dev/null 2>&1; then \
        usermod --shell /usr/bin/zsh "${USERNAME}"; \
    elif id -u vscode >/dev/null 2>&1; then \
        usermod --login "${USERNAME}" --home "/home/${USERNAME}" --move-home --shell /usr/bin/zsh vscode; \
        if getent group vscode >/dev/null 2>&1 && ! getent group "${USERNAME}" >/dev/null 2>&1; then \
            groupmod --new-name "${USERNAME}" vscode; \
        fi; \
    else \
        groupadd --gid "${USER_GID}" "${USERNAME}"; \
        useradd --uid "${USER_UID}" --gid "${USER_GID}" --create-home --shell /usr/bin/zsh "${USERNAME}"; \
    fi \
    && usermod -aG sudo "${USERNAME}" \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}" \
    && chmod 0440 "/etc/sudoers.d/${USERNAME}" \
    && mkdir -p \
        /workspace \
        "/home/${USERNAME}/.cache/mesa_shader_cache" \
        "/home/${USERNAME}/.cache/cargo-target" \
        "/home/${USERNAME}/.cache/uv" \
        "/home/${USERNAME}/.cargo/git" \
        "/home/${USERNAME}/.cargo/registry" \
        "/home/${USERNAME}/.rustup" \
    && chown -R "${USERNAME}:${USERNAME}" "/home/${USERNAME}" /workspace

USER non-root

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain "${RUST_VERSION}" \
    && rustup component add rustfmt clippy \
    && rustc --version \
    && cargo --version

RUN sh -c "$(curl -fsSL https://github.com/deluan/zsh-in-docker/releases/download/v1.2.1/zsh-in-docker.sh)" -- \
        -x \
        -p git \
        -p https://github.com/zsh-users/zsh-autosuggestions \
        -p https://github.com/zsh-users/zsh-completions \
        -p uv \
    && test -f /home/non-root/.zshrc \
    && sed -i '/export TERM=xterm/c\[ -z "$TERM" ] && export TERM=xterm-256color' /home/non-root/.zshrc \
    && mkdir -p /home/non-root/.cache

RUN printf '%s\n' \
        '' \
        'export UV_PROJECT_ENVIRONMENT=/workspace/.venv' \
        'export UV_CACHE_DIR=/home/non-root/.cache/uv' \
        'export VIRTUAL_ENV=/workspace/.venv' \
        'export XDG_CACHE_HOME=/home/non-root/.cache' \
        'export MESA_SHADER_CACHE_DIR=/home/non-root/.cache/mesa_shader_cache' \
        'export CARGO_TARGET_DIR=/home/non-root/.cache/cargo-target' \
        'export NVIDIA_VISIBLE_DEVICES=all' \
        'export NVIDIA_DRIVER_CAPABILITIES=all' \
        'export VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.x86_64.json' \
        'export PATH=/workspace/.venv/bin:/home/non-root/.cargo/bin:/home/non-root/.local/bin:$PATH' \
        >> /home/non-root/.zshrc

WORKDIR /workspace
